{
	"name": "bddiscordbot",
	"version": "3.0.1",
	"description": "BD4 Discord Bot",
	"main": "dist/app.js",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"start": "tsx src/app.ts",
		"start-prod": "cross-env BDBOT_PROD_MODE=TRUE node -r dotenv/config dist/app.js",
		"format": "prettier src/ --write",
		"lint": "eslint src/",
		"dev": "nodemon"
	},
	"engines": {
		"node": ">=24"
	},
	"author": "Kyle Stadelmann",
	"license": "ISC",
	"dependencies": {
		"@braintree/sanitize-url": "^7.1.2",
		"@discord-player/extractor": "^7.2.0",
		"@discordjs/voice": "^0.19.2",
		"@discordx/importer": "^1.3.3",
		"@discordx/pagination": "^4.4.2",
		"@discordx/utilities": "^8.0.0",
		"@isaacs/ttlcache": "^2.1.5",
		"axios": "^1.20.0",
		"cheerio": "^1.2.0",
		"cross-env": "^10.1.0",
		"csgo-predict-api": "^1.1.8",
		"discord-player": "^7.2.0",
		"discord-player-youtubei": "^2.0.0",
		"discord.js": "^14.27.0",
		"discordx": "^11.13.3",
		"dotenv": "^17.4.2",
		"dynamoose": "^4.2.0",
		"fast-glob": "^3.3.3",
		"mediaplex": "^1.0.0",
		"random-words": "^2.0.1",
		"reflect-metadata": "^0.2.2",
		"sodium-native": "^5.1.0",
		"tslib": "^2.8.1",
		"uuid": "^14.0.2",
		"youtube-dl-exec": "^3.1.13"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.13.3",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"nodemon": "^3.1.14",
		"prettier": "^3.9.6",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.68.0"
	},
	"type": "module"
}
